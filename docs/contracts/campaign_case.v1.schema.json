{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign_case.v1.schema.json",
  "title": "Campaign case v1 (producer: ai-market-intelligence; consumer: ConsultAI read-only adapter)",
  "description": "FROZEN 2026-11-17. One randomized e-mail campaign decision for one case. Every number carries a provenance tag. Additive optional fields stay v1; renaming, removing or re-typing a field requires v2. Cross-field rules that JSON Schema cannot express (counts <= denominators, rates = buyers / own-arm denominator, scenario arithmetic, null handling per record_type) are enforced by mi.campaign.contract.validate_case and listed in INTEGRATION_HANDOFF.md.",
  "type": "object",
  "required": [
    "contract_version", "record_type", "case_id", "generated_at", "producer", "dataset_provenance", "unit", "outcome",
    "arms", "observed_arm_metrics", "average_effects", "model", "held_out_policy_metrics", "model_vs_baselines",
    "buyer_impact_per_1000", "buyer_impact_interval_per_1000", "business_scenarios", "economic_thresholds",
    "recommendation", "marketing", "assumptions_and_unknowns", "published_references", "claims", "sources",
    "evidence_ids", "model_version", "run_id", "approval_required", "approval_status", "warnings"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "record_type": {"enum": ["SYNTHETIC_FIXTURE", "COMPUTED_EXPORT"]},
    "case_id": {"$ref": "#/$defs/case_id"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "producer": {
      "type": "object",
      "required": ["repo", "code_commit", "command"],
      "properties": {
        "repo": {"type": "string"},
        "code_commit": {"type": ["string", "null"]},
        "command": {"type": "string"}
      }
    },
    "dataset_provenance": {
      "type": "object",
      "required": ["source_id", "source_url", "file_url", "sha256", "bytes", "rows", "period", "terms", "redistribution"],
      "properties": {
        "source_id": {"type": "string"},
        "source_url": {"type": "string"},
        "file_url": {"type": "string"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"$ref": "#/$defs/count"},
        "rows": {"$ref": "#/$defs/count"},
        "period": {"const": "two_weeks_after_email"},
        "period_note": {"type": "string"},
        "terms": {"type": "string"},
        "redistribution": {"const": "RAW_FILE_LOCAL_ONLY_NOT_REDISTRIBUTED"}
      }
    },
    "unit": {"const": "unique_existing_customer"},
    "outcome": {
      "type": "object",
      "required": ["name", "definition", "horizon_days"],
      "properties": {
        "name": {"const": "conversion_within_two_weeks"},
        "definition": {"type": "string"},
        "horizon_days": {"const": 14}
      }
    },
    "arms": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "required": ["name", "role"],
        "properties": {"name": {"$ref": "#/$defs/arm_name"}, "role": {"enum": ["control", "treatment"]}}
      },
      "allOf": [
        {"contains": {"properties": {"name": {"const": "No E-Mail"}, "role": {"const": "control"}}, "required": ["name", "role"]}},
        {"contains": {"properties": {"name": {"const": "Mens E-Mail"}, "role": {"const": "treatment"}}, "required": ["name", "role"]}},
        {"contains": {"properties": {"name": {"const": "Womens E-Mail"}, "role": {"const": "treatment"}}, "required": ["name", "role"]}}
      ]
    },
    "observed_arm_metrics": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/observed_arm_metric"},
      "allOf": [
        {"contains": {"properties": {"arm": {"const": "No E-Mail"}, "role": {"const": "control"}}, "required": ["arm", "role"]}},
        {"contains": {"properties": {"arm": {"const": "Mens E-Mail"}, "role": {"const": "treatment"}}, "required": ["arm", "role"]}},
        {"contains": {"properties": {"arm": {"const": "Womens E-Mail"}, "role": {"const": "treatment"}}, "required": ["arm", "role"]}}
      ]
    },
    "average_effects": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/average_effect"},
      "allOf": [
        {"contains": {"properties": {"treatment_arm": {"const": "Mens E-Mail"}}, "required": ["treatment_arm"]}},
        {"contains": {"properties": {"treatment_arm": {"const": "Womens E-Mail"}}, "required": ["treatment_arm"]}}
      ]
    },
    "model": {
      "type": "object",
      "required": ["model_version", "status", "model_type", "outcome", "features_pre_treatment", "forbidden_post_treatment", "split", "protocol_path", "model_card_path", "secondary_metrics", "repeated_evaluation_caveat"],
      "properties": {
        "model_version": {"type": ["string", "null"]},
        "status": {"enum": ["NOT_RUN", "FITTED_REPEATED_EVALUATION"]},
        "model_type": {"type": "string"},
        "outcome": {"const": "conversion_within_two_weeks"},
        "features_pre_treatment": {"type": "array", "items": {"type": "string", "not": {"enum": ["visit", "conversion", "spend"]}}},
        "forbidden_post_treatment": {
          "type": "array", "items": {"type": "string"},
          "allOf": [{"contains": {"const": "visit"}}, {"contains": {"const": "conversion"}}, {"contains": {"const": "spend"}}]
        },
        "split": {
          "type": "object",
          "required": ["method", "seed", "n_train", "n_validation", "n_test"],
          "properties": {
            "method": {"type": "string"},
            "seed": {"type": ["integer", "null"]},
            "n_train": {"$ref": "#/$defs/count"},
            "n_validation": {"$ref": "#/$defs/count"},
            "n_test": {"$ref": "#/$defs/count"}
          }
        },
        "protocol_path": {"type": "string"},
        "model_card_path": {"type": "string"},
        "secondary_metrics": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name", "arm", "score", "metric"],
            "properties": {"name": {"type": "string"}, "arm": {"type": "string"}, "score": {"type": "string"}, "metric": {"$ref": "#/$defs/tagged_value"}}
          }
        },
        "repeated_evaluation_caveat": {"type": "string"}
      }
    },
    "held_out_policy_metrics": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/policy_metric"},
      "allOf": [
        {"contains": {"properties": {"policy_family": {"const": "NO_EMAIL"}}, "required": ["policy_family"]}},
        {"contains": {"properties": {"policy_family": {"const": "SEND_ALL"}}, "required": ["policy_family"]}},
        {"contains": {"properties": {"policy_family": {"const": "RANDOM"}}, "required": ["policy_family"]}},
        {"contains": {"properties": {"policy_family": {"const": "RULE"}}, "required": ["policy_family"]}},
        {"contains": {"properties": {"policy_family": {"const": "MODEL"}}, "required": ["policy_family"]}}
      ]
    },
    "model_vs_baselines": {
      "type": "object",
      "required": ["primary_contact_share", "model_policy_id", "random_policy_id", "rule_policy_id", "model_minus_random_per_1000_contacts", "model_minus_rule_per_1000_contacts", "point_estimate_beats_random", "point_estimate_beats_rule", "stable_vs_random", "stable_vs_rule", "verdict", "verdict_text"],
      "properties": {
        "primary_contact_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "model_policy_id": {"type": ["string", "null"]},
        "random_policy_id": {"type": ["string", "null"]},
        "rule_policy_id": {"type": ["string", "null"]},
        "model_minus_random_per_1000_contacts": {"$ref": "#/$defs/held_out_value"},
        "model_minus_rule_per_1000_contacts": {"$ref": "#/$defs/held_out_value"},
        "point_estimate_beats_random": {"type": ["boolean", "null"]},
        "point_estimate_beats_rule": {"type": ["boolean", "null"]},
        "stable_vs_random": {"type": ["boolean", "null"], "description": "true only if the 95% interval of model minus random excludes zero in the model's favour"},
        "stable_vs_rule": {"type": ["boolean", "null"]},
        "verdict": {"enum": ["NOT_RUN", "MODEL_WIN_STABLE", "MODEL_AHEAD_NOT_STABLE", "NO_MODEL_ADVANTAGE"]},
        "verdict_text": {"type": "string"}
      }
    },
    "buyer_impact_per_1000": {
      "type": "object",
      "required": ["value", "tag", "unit", "policy_id", "arm", "control_arm", "split", "treated_n", "treated_buyers", "control_n", "control_buyers"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "tag": {"enum": ["OBSERVED", "HELD_OUT_ESTIMATE", "UNKNOWN"]},
        "unit": {"type": "string"},
        "policy_id": {"type": ["string", "null"]},
        "arm": {"type": ["string", "null"]},
        "control_arm": {"const": "No E-Mail"},
        "split": {"enum": ["full_sample", "test"]},
        "treated_n": {"$ref": "#/$defs/count"},
        "treated_buyers": {"$ref": "#/$defs/count"},
        "control_n": {"$ref": "#/$defs/count"},
        "control_buyers": {"$ref": "#/$defs/count"},
        "note": {"type": "string"}
      },
      "if": {"properties": {"tag": {"const": "UNKNOWN"}}, "required": ["tag"]},
      "then": {"properties": {"value": {"const": null}}}
    },
    "buyer_impact_interval_per_1000": {
      "type": "object",
      "required": ["low", "high", "level", "method"],
      "properties": {
        "low": {"type": ["number", "null"]},
        "high": {"type": ["number", "null"]},
        "level": {"const": 0.95},
        "method": {"type": "string"}
      }
    },
    "business_scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}},
    "economic_thresholds": {"type": "array", "items": {"$ref": "#/$defs/threshold"}},
    "recommendation": {
      "type": "object",
      "required": ["status", "decision", "recommended_policy_id", "recommended_arm", "contact_share", "conditions", "rationale", "would_reverse_if", "alternative_if_model_inconclusive", "no_email_option", "holdout_plan", "human_decision_required"],
      "properties": {
        "status": {"enum": ["PENDING_ANALYSIS", "BROAD_SEND_WITH_HOLDOUT_IF_ECONOMICS_CONFIRMED", "TARGETED_SEND_WITH_HOLDOUT_IF_ECONOMICS_CONFIRMED", "NO_EMAIL", "MORE_EVIDENCE_REQUIRED"]},
        "decision": {"type": "string"},
        "recommended_policy_id": {"type": ["string", "null"]},
        "recommended_arm": {"enum": ["Mens E-Mail", "Womens E-Mail", "MODEL_CHOOSES_ARM", "NONE", null]},
        "contact_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "conditions": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "array", "items": {"type": "string"}},
        "would_reverse_if": {"type": "array", "items": {"type": "string"}},
        "alternative_if_model_inconclusive": {"type": "string"},
        "no_email_option": {"type": "string"},
        "holdout_plan": {"type": "object"},
        "human_decision_required": {"const": true}
      }
    },
    "marketing": {
      "type": "object",
      "required": ["research_question", "audience", "segmentation", "targeting", "positioning", "four_ps", "journey_barrier_hypotheses", "message_drafts", "action_plan", "success_metric"],
      "properties": {
        "research_question": {"type": "string"},
        "audience": {"type": "string"},
        "segmentation": {"type": "string"},
        "targeting": {"type": "string"},
        "positioning": {"type": "string"},
        "four_ps": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "required": ["p", "decision", "alternatives", "tag", "note"],
            "properties": {
              "p": {"enum": ["Product", "Price", "Place", "Promotion"]},
              "decision": {"type": "string"},
              "alternatives": {"type": "array", "items": {"type": "string"}},
              "tag": {"$ref": "#/$defs/tag"},
              "note": {"type": "string"}
            }
          }
        },
        "journey_barrier_hypotheses": {"type": "array", "items": {"type": "string"}},
        "message_drafts": {
          "type": "array",
          "items": {
            "type": "object", "required": ["draft_id", "arm", "subject", "body", "status"],
            "properties": {
              "draft_id": {"type": "string"}, "arm": {"type": "string"}, "subject": {"type": "string"}, "body": {"type": "string"},
              "status": {"const": "DRAFT_HYPOTHESIS_NOT_SENT"}
            }
          }
        },
        "action_plan": {
          "type": "array",
          "items": {
            "type": "object", "required": ["step", "owner_role", "action", "status"],
            "properties": {
              "step": {"type": "integer", "minimum": 1}, "owner_role": {"type": "string"}, "action": {"type": "string"},
              "status": {"enum": ["PENDING_HUMAN", "DRAFT", "BLOCKED_UNTIL_APPROVED"]}
            }
          }
        },
        "success_metric": {"type": "string"}
      }
    },
    "assumptions_and_unknowns": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "name", "value", "tag", "unit", "needed_from", "note"],
        "properties": {
          "id": {"type": "string"}, "name": {"type": "string"},
          "value": {"type": ["number", "string", "null"]},
          "tag": {"enum": ["ASSUMPTION", "UNKNOWN"]},
          "unit": {"type": "string"}, "needed_from": {"type": "string"}, "note": {"type": "string"}
        },
        "if": {"properties": {"tag": {"const": "UNKNOWN"}}, "required": ["tag"]},
        "then": {"properties": {"value": {"const": null}}}
      }
    },
    "published_references": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "label", "value", "unit", "tag", "source_id", "locator", "note"],
        "properties": {
          "id": {"type": "string"}, "label": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"},
          "tag": {"const": "PUBLISHED_REFERENCE"},
          "source_id": {"type": "string"}, "locator": {"type": "string"}, "note": {"type": "string"}
        }
      }
    },
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["source_id", "title", "url", "kind", "accessed"],
        "properties": {
          "source_id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string"},
          "kind": {"enum": ["DATASET", "PUBLICATION", "DOCUMENTATION", "LOCAL_ARTIFACT"]},
          "accessed": {"type": ["string", "null"]}, "note": {"type": "string"}
        }
      }
    },
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "model_version": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "approval_required": {"const": true},
    "approval_status": {"const": "DRAFT_REQUIRES_HUMAN"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "case_id": {"const": "HILLSTROM_EMAIL_2008"},
    "tag": {"enum": ["OBSERVED", "HELD_OUT_ESTIMATE", "ASSUMPTION", "PUBLISHED_REFERENCE", "UNKNOWN"]},
    "arm_name": {"enum": ["No E-Mail", "Mens E-Mail", "Womens E-Mail"]},
    "count": {"type": ["integer", "null"], "minimum": 0},
    "ci95": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "tagged_value": {
      "type": "object",
      "required": ["value", "tag", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["number", "null"]},
        "tag": {"$ref": "#/$defs/tag"},
        "unit": {"type": "string"},
        "ci95": {"$ref": "#/$defs/ci95"},
        "ci_method": {"type": ["string", "null"]},
        "note": {"type": "string"}
      },
      "if": {"properties": {"tag": {"const": "UNKNOWN"}}, "required": ["tag"]},
      "then": {"properties": {"value": {"const": null}, "ci95": {"const": null}}}
    },
    "observed_value": {"allOf": [{"$ref": "#/$defs/tagged_value"}, {"properties": {"tag": {"enum": ["OBSERVED", "UNKNOWN"]}}}]},
    "held_out_value": {"allOf": [{"$ref": "#/$defs/tagged_value"}, {"properties": {"tag": {"enum": ["HELD_OUT_ESTIMATE", "UNKNOWN"]}}}]},
    "experiment_value": {"allOf": [{"$ref": "#/$defs/tagged_value"}, {"properties": {"tag": {"enum": ["OBSERVED", "HELD_OUT_ESTIMATE", "UNKNOWN"]}}}]},
    "assumed_value": {"allOf": [{"$ref": "#/$defs/tagged_value"}, {"properties": {"tag": {"enum": ["ASSUMPTION", "UNKNOWN"]}}}]},
    "observed_arm_metric": {
      "type": "object",
      "required": ["case_id", "arm", "role", "split", "n_customers", "buyers", "purchase_rate", "spend_per_customer"],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "arm": {"$ref": "#/$defs/arm_name"},
        "role": {"enum": ["control", "treatment"]},
        "split": {"const": "full_sample"},
        "n_customers": {"$ref": "#/$defs/count"},
        "buyers": {"$ref": "#/$defs/count"},
        "purchase_rate": {"$ref": "#/$defs/observed_value"},
        "spend_per_customer": {"$ref": "#/$defs/observed_value"}
      }
    },
    "average_effect": {
      "type": "object",
      "required": ["case_id", "treatment_arm", "control_arm", "split", "treated_n", "treated_buyers", "control_n", "control_buyers", "rate_difference", "additional_buyers_per_1000", "relative_lift", "incremental_spend_per_contact"],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "treatment_arm": {"enum": ["Mens E-Mail", "Womens E-Mail"]},
        "control_arm": {"const": "No E-Mail"},
        "split": {"const": "full_sample"},
        "treated_n": {"$ref": "#/$defs/count"},
        "treated_buyers": {"$ref": "#/$defs/count"},
        "control_n": {"$ref": "#/$defs/count"},
        "control_buyers": {"$ref": "#/$defs/count"},
        "rate_difference": {"allOf": [{"$ref": "#/$defs/observed_value"}, {"required": ["ci95", "ci_method"]}]},
        "additional_buyers_per_1000": {"allOf": [{"$ref": "#/$defs/observed_value"}, {"required": ["ci95", "ci_method"]}]},
        "relative_lift": {"$ref": "#/$defs/observed_value"},
        "incremental_spend_per_contact": {"allOf": [{"$ref": "#/$defs/observed_value"}, {"required": ["ci95", "ci_method"]}]}
      }
    },
    "policy_metric": {
      "type": "object",
      "required": ["case_id", "policy_id", "policy_family", "label", "arm_assignment", "control_arm", "split", "contact_share", "eligible_n", "contacted_n", "treated_n", "treated_buyers", "control_n", "control_buyers", "additional_buyers_per_1000_contacts", "additional_buyers_per_1000_eligible", "incremental_spend_per_contact", "comparisons", "small_cell_warning", "is_primary"],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "policy_id": {"type": "string"},
        "policy_family": {"enum": ["NO_EMAIL", "SEND_ALL", "RANDOM", "RULE", "MODEL"]},
        "label": {"type": "string"},
        "arm_assignment": {"enum": ["Mens E-Mail", "Womens E-Mail", "MODEL_CHOOSES_ARM", "NONE"]},
        "control_arm": {"const": "No E-Mail"},
        "split": {"const": "test"},
        "contact_share": {"type": "number", "minimum": 0, "maximum": 1},
        "eligible_n": {"$ref": "#/$defs/count", "description": "all held-out customers (three arms) the policy chooses from"},
        "contacted_n": {"$ref": "#/$defs/count", "description": "held-out customers (three arms) the policy would contact"},
        "treated_n": {"$ref": "#/$defs/count", "description": "selected customers whose randomized arm equals the arm the policy assigns them"},
        "treated_buyers": {"$ref": "#/$defs/count"},
        "control_n": {"$ref": "#/$defs/count", "description": "selected customers randomized to No E-Mail"},
        "control_buyers": {"$ref": "#/$defs/count"},
        "additional_buyers_per_1000_contacts": {"allOf": [{"$ref": "#/$defs/held_out_value"}, {"required": ["ci95", "ci_method"]}]},
        "additional_buyers_per_1000_eligible": {"allOf": [{"$ref": "#/$defs/held_out_value"}, {"required": ["ci95", "ci_method"]}]},
        "incremental_spend_per_contact": {"allOf": [{"$ref": "#/$defs/held_out_value"}, {"required": ["ci95", "ci_method"]}]},
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object", "required": ["against_policy_id", "difference_per_1000_contacts", "ci_excludes_zero"],
            "properties": {
              "against_policy_id": {"type": "string"},
              "difference_per_1000_contacts": {"allOf": [{"$ref": "#/$defs/held_out_value"}, {"required": ["ci95", "ci_method"]}]},
              "ci_excludes_zero": {"type": ["boolean", "null"]}
            }
          }
        },
        "small_cell_warning": {"type": ["boolean", "null"]},
        "is_primary": {"type": "boolean"}
      },
      "if": {"properties": {"policy_family": {"const": "NO_EMAIL"}}, "required": ["policy_family"]},
      "then": {"properties": {"contact_share": {"const": 0}, "arm_assignment": {"const": "NONE"}, "contacted_n": {"enum": [0, null]}}},
      "else": {"properties": {"contact_share": {"exclusiveMinimum": 0}, "arm_assignment": {"enum": ["Mens E-Mail", "Womens E-Mail", "MODEL_CHOOSES_ARM"]}}}
    },
    "scenario": {
      "type": "object",
      "required": ["case_id", "scenario_id", "label", "value_kind", "policy_id", "arm", "contacts", "incremental_spend_per_contact", "assumed_margin", "cost_per_contact", "fixed_setup_cost", "contribution", "formula"],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "scenario_id": {"type": "string"},
        "label": {"type": "string"},
        "value_kind": {"const": "SCENARIO_NOT_MEASURED_PROFIT"},
        "policy_id": {"type": ["string", "null"]},
        "arm": {"type": "string"},
        "contacts": {"$ref": "#/$defs/assumed_value"},
        "incremental_spend_per_contact": {"$ref": "#/$defs/experiment_value"},
        "assumed_margin": {"$ref": "#/$defs/assumed_value"},
        "cost_per_contact": {"$ref": "#/$defs/assumed_value"},
        "fixed_setup_cost": {"$ref": "#/$defs/assumed_value"},
        "contribution": {"$ref": "#/$defs/assumed_value", "description": "scenario arithmetic; never OBSERVED, never a measured profit"},
        "formula": {"const": "contribution = contacts * (incremental_spend_per_contact * assumed_margin - cost_per_contact) - fixed_setup_cost"}
      }
    },
    "threshold": {
      "type": "object",
      "required": ["case_id", "threshold_id", "arm", "label", "assumed_margin", "break_even_cost_per_contact", "break_even_cost_per_contact_conservative"],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "threshold_id": {"type": "string"},
        "arm": {"type": "string"},
        "label": {"type": "string"},
        "assumed_margin": {"$ref": "#/$defs/assumed_value"},
        "break_even_cost_per_contact": {"$ref": "#/$defs/assumed_value", "description": "incremental_spend_per_contact * assumed_margin (point estimate)"},
        "break_even_cost_per_contact_conservative": {"$ref": "#/$defs/assumed_value", "description": "same, using the lower 95% bound of incremental spend"}
      }
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "case_id", "text", "value", "unit", "tag", "dataset_sha256", "denominator", "period", "arm", "split", "model_version", "uncertainty", "source_id", "slide_safe"],
      "properties": {
        "claim_id": {"type": "string"},
        "case_id": {"$ref": "#/$defs/case_id"},
        "text": {"type": "string"},
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": "string"},
        "tag": {"$ref": "#/$defs/tag"},
        "dataset_sha256": {"type": ["string", "null"]},
        "denominator": {"type": ["string", "null"], "description": "who is counted, with n (for example '21,307 customers randomized to Mens E-Mail')"},
        "period": {"type": ["string", "null"]},
        "arm": {"type": ["string", "null"]},
        "split": {"enum": ["full_sample", "train", "validation", "test", "not_applicable"]},
        "model_version": {"type": ["string", "null"]},
        "uncertainty": {"type": ["string", "null"]},
        "source_id": {"type": "string"},
        "slide_safe": {"type": "boolean", "description": "true = may be quoted on a slide with its tag and denominator"}
      },
      "if": {"properties": {"tag": {"const": "UNKNOWN"}}, "required": ["tag"]},
      "then": {"properties": {"value": {"const": null}}}
    }
  }
}
